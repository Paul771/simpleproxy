<KnowledgeGraph>
  <Project NAME="SimpleProxy" VERSION="0.2.0">
    <keywords>telegram, proxy, connect, nodejs, bot-api, wispbyte, tunnel</keywords>
    <annotation>Forward HTTP CONNECT-прокси для Telegram Bot API (api.telegram.org) на Node.js (ноль внешних зависимостей), развёртывается на бесплатном хостинге Wispbyte. TLS end-to-end, токены ботов прокси не видит. Allowlist только *.telegram.org:443, опциональная basic auth.</annotation>

    <M-CONFIG NAME="Config" TYPE="UTILITY" STATUS="implemented">
      <purpose>Чтение и валидация конфигурации из env (HTTP + MTProto + anti-DPI: mask/replay/ALPN/IPv6)</purpose>
      <path>src/config.js</path>
      <depends>none</depends>
      <verification-ref>V-M-CONFIG</verification-ref>
      <annotations>
        <fn-loadConfig PURPOSE="Загрузить и валидировать конфиг из env" />
      </annotations>
    </M-CONFIG>

    <M-LOG NAME="Log" TYPE="UTILITY" STATUS="implemented">
      <purpose>Единственный форматтер логов [proxy][marker] с redaction</purpose>
      <path>src/log.js</path>
      <depends>none</depends>
      <verification-ref>V-M-LOG</verification-ref>
      <annotations>
        <fn-makeLog PURPOSE="Создать функцию логирования" />
      </annotations>
    </M-LOG>

    <M-ALLOW NAME="Allow" TYPE="CORE_LOGIC" STATUS="implemented">
      <purpose>Строгий парсер authority и allowlist-проверка</purpose>
      <path>src/allow.js</path>
      <depends>none</depends>
      <verification-ref>V-M-ALLOW</verification-ref>
      <annotations>
        <fn-normalizeTarget PURPOSE="Распарсить CONNECT authority в {host, port} или null" />
        <fn-isAllowed PURPOSE="Проверить target против правил allowlist" />
      </annotations>
    </M-ALLOW>

    <M-AUTH NAME="Auth" TYPE="CORE_LOGIC" STATUS="implemented">
      <purpose>Парсинг и проверка Proxy-Authorization: Basic (timing-safe)</purpose>
      <path>src/auth.js</path>
      <depends>node:crypto</depends>
      <verification-ref>V-M-AUTH</verification-ref>
      <annotations>
        <fn-parseBasicAuth PURPOSE="Распарсить заголовок Basic в {user, pass}" />
        <fn-checkAuth PURPOSE="Проверить заголовок против заданных creds" />
      </annotations>
    </M-AUTH>

    <M-TUNNEL NAME="Tunnel" TYPE="CORE_LOGIC" STATUS="implemented">
      <purpose>Байтовый туннель client↔upstream со счётчиками и idle-таймером</purpose>
      <path>src/tunnel.js</path>
      <depends>M-LOG</depends>
      <verification-ref>V-M-TUNNEL</verification-ref>
      <annotations>
        <fn-openTunnel PURPOSE="Запустить двусторонний pump туннеля" />
      </annotations>
    </M-TUNNEL>

    <M-PROXY NAME="Proxy" TYPE="ENTRY_POINT" STATUS="implemented">
      <purpose>CONNECT-парсер на raw-socket: auth→allow→cap→tunnel, отклонение plain-HTTP, graceful start</purpose>
      <path>src/proxy.js</path>
      <depends>M-CONFIG, M-ALLOW, M-AUTH, M-TUNNEL, M-LOG</depends>
      <verification-ref>V-M-PROXY</verification-ref>
      <annotations>
        <fn-createConnectHandler PURPOSE="Создать http-connect/http-other обработчики для mux" />
        <fn-start PURPOSE="Запустить listen и обработать SIGTERM/SIGINT" />
      </annotations>
    </M-PROXY>

    <M-MUX NAME="Mux" TYPE="ENTRY_POINT" STATUS="implemented">
      <purpose>Протокольный мультиплексор: определение HTTP CONNECT vs MTProto по первым байтам, маршрутизация</purpose>
      <path>src/mux.js</path>
      <depends>none (handlers injected)</depends>
      <verification-ref>V-M-MUX</verification-ref>
      <annotations>
        <fn-createMuxServer PURPOSE="net.Server, читающий первые байты и маршрутизирующий" />
        <fn-classifyProtocol PURPOSE="Определить протокол по head" />
      </annotations>
    </M-MUX>

    <M-MTPROTO NAME="MTProto" TYPE="CORE_LOGIC" STATUS="implemented">
      <purpose>Obfuscated2 handshake parse/build и DC mapping (IPv4+IPv6, preferIpv6) (чистая логика)</purpose>
      <path>src/mtproto.js</path>
      <depends>node:crypto</depends>
      <verification-ref>V-M-MTPROTO</verification-ref>
      <annotations>
        <fn-parseClientHandshake PURPOSE="Валидировать 64-байтный handshake клиента по секретам" />
        <fn-buildUpstreamHandshake PURPOSE="Построить handshake к DC (FAST_MODE зеркалирование ключей)" />
        <fn-getDcAddress PURPOSE="Разрешить dc_idx в адрес DC (IPv4/IPv6 по opts.preferIpv6)" />
        <fn-createAesCtr PURPOSE="Stateful AES-256-CTR шифр" />
      </annotations>
    </M-MTPROTO>

    <M-MTPROTO-SERVER NAME="MTProtoServer" TYPE="CORE_LOGIC" STATUS="implemented">
      <purpose>MTProto-обработчик соединений: plain + fake-TLS handshake → подключение к DC → relay (FAST_MODE); doppelganger-тайминги, pending-handshake cap</purpose>
      <path>src/mtproto-server.js</path>
      <depends>M-MTPROTO, M-FAKETLS, M-LOG</depends>
      <verification-ref>V-M-MTPROTO</verification-ref>
      <annotations>
        <fn-createMtprotoHandler PURPOSE="Создать mtproto-обработчик для mux" />
      </annotations>
    </M-MTPROTO-SERVER>

    <M-FAKETLS NAME="FakeTLS" TYPE="CORE_LOGIC" STATUS="implemented">
      <purpose>Fake-TLS (ee-secret) handshake: HMAC-валидация ClientHello, ServerHello с ALPN, TLS-record framing, SNI-парсинг, TLS-alert</purpose>
      <path>src/faketls.js</path>
      <depends>node:crypto</depends>
      <verification-ref>V-M-FAKETLS</verification-ref>
      <annotations>
        <fn-validateClientHello PURPOSE="Валидировать ClientHello по HMAC(secret, msg)" />
        <fn-buildServerHello PURPOSE="Построить фейковый ServerHello (+ALPN) + CCS + app-data" />
        <fn-createTlsRecordReader PURPOSE="Stateful парсер TLS-записей (app-data)" />
        <fn-wrapTlsRecord PURPOSE="Обернуть данные в TLS 1.3 app-data запись" />
        <fn-extractSni PURPOSE="Распарсить SNI hostname из ClientHello (null если нет)" />
        <fn-buildTlsAlert PURPOSE="Построить fatal TLS alert (reject_handshake)" />
        <fn-buildAlpnExtension PURPOSE="Построить ALPN-расширение для ServerHello" />
      </annotations>
    </M-FAKETLS>

    <M-MASK NAME="Mask" TYPE="CORE_LOGIC" STATUS="implemented">
      <purpose>Traffic masking: прозрачный TCP-splice non-keyed/unknown-SNI клиентов к mask_host (анти-DPI)</purpose>
      <path>src/mask.js</path>
      <depends>M-LOG, M-FAKETLS (extractSni)</depends>
      <verification-ref>V-M-MASK</verification-ref>
      <annotations>
        <fn-maskConnection PURPOSE="Splice клиентского сокета (+ буферизованный head) к mask_host:mask_port" />
      </annotations>
    </M-MASK>

    <M-REPLAY NAME="ReplayGuard" TYPE="CORE_LOGIC" STATUS="implemented">
      <purpose>Replay-защита: LRU+TTL по digest ClientHello + проверка свежести timestamp</purpose>
      <path>src/replay-guard.js</path>
      <depends>none</depends>
      <verification-ref>V-M-REPLAY</verification-ref>
      <annotations>
        <fn-createReplayGuard PURPOSE="Создать stateful admit/reject guard по digest" />
      </annotations>
    </M-REPLAY>

    <M-TLS-PROFILE NAME="TlsProfile" TYPE="CORE_LOGIC" STATUS="implemented">
      <purpose>Захват структуры TLS server-flight у fronted-домена и replay её в fake ServerHello (anti-DPI, telemt-style)</purpose>
      <path>src/tls-profile.js</path>
      <depends>node:net, node:crypto, M-FAKETLS</depends>
      <verification-ref>V-M-TLS-PROFILE</verification-ref>
      <annotations>
        <fn-buildCaptureClientHello PURPOSE="Построить TLS 1.3 ClientHello для probe origin" />
        <fn-captureTlsProfile PURPOSE="Сырой TCP-capture структуры server-flight (cipher/ALPN/CCS/размеры 0x17/inter-arrival delays)" />
        <fn-createProfileManager PURPOSE="Кэш профиля с periodic refresh" />
        <fn-createTlsRecordObserver PURPOSE="Stateful наблюдатель TLS-записей (type+size)" />
      </annotations>
    </M-TLS-PROFILE>

