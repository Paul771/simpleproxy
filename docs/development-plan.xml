  <DataFlow>
    <DF-1 NAME="CONNECTHandshake" TRIGGER="Клиент шлёт CONNECT api.telegram.org:443">
      <step-1>http.Server получает 'connect' (req.url = authority)</step-1>
      <step-2>auth-проверка: checkAuth(req.headers['proxy-authorization']) → fail: 407 + лог [proxy][auth_fail]</step-2>
      <step-3>normalizeTarget(authority) → null: 400 + destroy</step-3>
      <step-4>isAllowed(target, rules) → false: 403 + destroy + лог [proxy][deny]</step-4>
      <step-5>activeTunnels >= maxTunnels → 503 + destroy + лог [proxy][cap_limit]</step-5>
      <step-6>net.connect({host, port}) → 200 Connection Established + openTunnel</step-6>
      <evidence>[proxy][connect], [proxy][deny], [proxy][auth_fail], [proxy][cap_limit]</evidence>
    </DF-1>
    <DF-2 NAME="TunnelData" TRIGGER="200 отправлен, туннель открыт">
      <step-1>pump: clientSocket.pipe(upstream), upstream.pipe(clientSocket)</step-1>
      <step-2>счётчики bytes_in/bytes_out на 'data'</step-2>
      <step-3>закрытие/ошибка любого конца → destroy обоих</step-3>
      <step-4>лог закрытия [tunnel][close] с байтами и длительностью</step-4>
      <evidence>[tunnel][close] ... bytes_in bytes_out duration_ms; e2e: echo-данные байт-в-байт</evidence>
    </DF-2>
    <DF-3 NAME="IdleLifecycle" TRIGGER="Туннель открыт, активность отсутствует">
      <step-1>таймер arm при открытии (cfg.idleTimeoutMs)</step-1>
      <step-2>reset на любой 'data' с любой стороны</step-2>
      <step-3>expiry → destroy обеих + лог [tunnel][idle_timeout]</step-3>
      <evidence>[tunnel][idle_timeout]; e2e с коротким таймаутом</evidence>
    </DF-3>
    <DF-4 NAME="Capacity" TRIGGER="Каждый CONNECT">
      <step-1>activeTunnels++ на входе, -- при закрытии</step-1>
      <step-2>>= maxTunnels → 503</step-2>
      <evidence>[proxy][cap_limit]</evidence>
    </DF-4>
    <DF-MASK NAME="AntiDpiMasking" TRIGGER="fake-TLS ClientHello с unknown SNI / неверным digest / replay">
      <step-1>mtproto-handler: validateClientHello → null (auth fail) ИЛИ SNI ≠ MTPROTO_TLS_DOMAIN ИЛИ replay → routeUnknown</step-1>
      <step-2>action=mask → maskConnection: net.connect к mtprotoMaskHost:mtprotoMaskPort, forward буферизованного ClientHello, bidirectional splice</step-2>
      <step-3>action=reject → socket.write(buildTlsAlert(112)) + destroy (nginx ssl_reject_handshake)</step-3>
      <step-4>action=drop → socket.destroy (legacy)</step-4>
      <evidence>[proxy][faketls_auth_fail], [proxy][faketls_unknown_sni], [proxy][faketls_replay], [proxy][mask_connect], [proxy][mask_close]</evidence>
    </DF-MASK>
    <DF-METRICS NAME="MetricsScrape" TRIGGER="Prometheus scraper стучит на MTPROTO_METRICS_PORT /metrics">
      <step-1>metrics server: parse HTTP request line</step-1>
      <step-2>GET /metrics → 200 text/plain; version=0.0.4 + render() реестра (counters/gauges)</step-2>
      <step-3>иначе → 404</step-3>
      <evidence>[proxy][metrics_listen]; HTTP-ответ содержит # TYPE/HELP + значения счётчиков</evidence>
    </DF-METRICS>
    <DF-RELOAD NAME="ConfigHotReload" TRIGGER="Сигнал SIGUSR2 процессу (POSIX); на Windows — no-op">
      <step-1>loadConfig() → при INVALID_ENV лог [proxy][reload_fail], старый конфиг сохраняется</step-1>
      <step-2>applyConfigUpdate(cfg, next): in-place мутация всех полей кроме port/host; handlers читают cfg.* fresh → секреты/маска/caps применяются сразу</step-2>
      <step-3>поля boot-time state (replay guard, profile manager, metrics server, listen port) → flagged restart_needed</step-3>
      <evidence>[proxy][reload] { changed, fields, restart_needed }</evidence>
    </DF-RELOAD>
    <DF-USER NAME="PerUserLimits" TRIGGER="MTProto handshake с валидным секретом, сопоставленным user-записи">
      <step-1>userStore.resolve(secretHex) → User</step-1>
      <step-2>admit: expired / over byteQuota / over maxConns → false → destroy + лог [proxy][mtproto_user_reject]</step-2>
      <step-3>на relay: addBytes(user, len) на каждый chunk; на close: release(user)</step-3>
      <evidence>[proxy][mtproto_user_reject][DF-4]; per-user snapshot доступен через metrics/тесты</evidence>
    </DF-USER>
    <DF-BLOCK NAME="BlocklistEdge" TRIGGER="TCP-соединение от IP, попавшего в MTPROTO_BLOCKLIST">
      <step-1>mux: isBlocked(remoteAddress) → true</step-1>
      <step-2>лог [proxy][blocklist_reject] + silent destroy (handler не вызывается, байты не пишутся)</step-2>
      <evidence>[proxy][blocklist_reject][DF-BLOCK]; e2e: blocked → close без данных, handler не достигнут</evidence>
    </DF-BLOCK>
    <DF-DC-FALLBACK NAME="DcAddressFallback" TRIGGER="TCP connect к первому DC-кандидату завершился ошибкой">
      <step-1>resolveDc(dcIdx, {preferIpv6}) → массив кандидатов (preferred family первым)</step-1>
      <step-2>net.connect к candidates[0]; connect-failure → лог [proxy][mtproto_dc_fallback] + candidates[1]</step-2>
      <step-3>все кандидаты исчерпаны → destroy + лог [proxy][mtproto_upstream_error]</step-3>
      <evidence>[proxy][mtproto_dc_fallback][DF-1]; e2e: dead-первый-кандидат → round-trip через второй</evidence>
    </DF-DC-FALLBACK>
  </DataFlow>

