      <step-4 module="M-MTPROTO-SERVER" status="done" verification="V-M-MTPROTO">src/mtproto-server.js + tests/mtproto.e2e.test.js (fake-DC)</step-4>
      <step-5 module="M-MTPROTO-SERVER" status="done" verification="V-M-MTPROTO">ссылки tg://proxy в логе, README, финальные GRACE-доки</step-5>
    </Phase-4>
  </ImplementationOrder>

  <ExecutionPolicy>
    <default-profile>balanced</default-profile>
    <controller-owns>docs/development-plan.xml, docs/knowledge-graph.xml, docs/verification-plan.xml</controller-owns>
    <worker-owns>Только исходники модулей и module-local тесты в пределах src/ и tests/</worker-owns>
