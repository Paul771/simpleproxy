        <inputs>
          <param name="handshake" type="Buffer(64)" />
          <param name="secrets" type="Buffer[]" />
          <param name="parsed" type="ParsedHandshake" />
          <param name="dcIdx" type="number" />
        </inputs>
        <outputs>
          <param name="ParsedHandshake | null" type="{ secret, protoTag, dcIdx, encKey, encIv, decryptor }" />
          <param name="{ rndEnc, encryptorUp, decryptorUp }" type="Upstream handshake + stateful шифры" />
          <param name="{ host, port } | null" type="Адрес DC" />
        </outputs>
        <errors>
          <error code="none" />
        </errors>
      </contract>
      <interface>
        <export-parseClientHandshake PURPOSE="Валидировать handshake по секретам" />
        <export-buildUpstreamHandshake PURPOSE="Построить upstream handshake (FAST_MODE зеркалирование)" />
        <export-getDcAddress PURPOSE="dc_idx → одиночный адрес DC (IPv4/IPv6)" />
        <export-getDcAddressCandidates PURPOSE="dc_idx → упорядоченный список кандидатов (preferred family первым) для fallback" />
        <export-createAesCtr PURPOSE="Stateful AES-256-CTR" />
      </interface>
      <depends>node:crypto</depends>
      <target>
        <source>src/mtproto.js</source>
        <tests>tests/mtproto.test.js</tests>
      </target>
      <observability>
        <log-prefix>[mtproto]</log-prefix>
        <critical-block>BLOCK_PARSE_HANDSHAKE</critical-block>
      </observability>
      <verification-ref>V-M-MTPROTO</verification-ref>
      <notes>
        <note-1>Константы и layout по референсу alexbers/mtprotoproxy (SKIP_LEN=8, PROTO_TAG_POS=56, DC_IDX_POS=60).</note-1>
      </notes>
    </M-MTPROTO>

    <M-MTPROTO-SERVER NAME="MTProtoServer" TYPE="CORE_LOGIC" LAYER="2" ORDER="3" STATUS="implemented">
      <contract>
        <purpose>MTProto-обработчик соединений: handshake → подключение к DC (IPv4↔IPv6 fallback) → relay (FAST_MODE)</purpose>
        <inputs>
          <param name="cfg" type="Config" />
          <param name="log" type="Log" />
          <param name="resolveDc" type="(dcIdx, opts) => Array<{host,port}> | {host,port} | null" />
        </inputs>
        <outputs>
          <param name="(socket, head) => void" type="Обработчик для mux" />
        </outputs>
        <errors>
          <error code="none" />
        </errors>
      </contract>
      <interface>
        <export-createMtprotoHandler PURPOSE="Создать mtproto-обработчик для mux" />
      </interface>
      <depends>M-MTPROTO, M-LOG, M-FAKETLS, M-REPLAY, M-TLS-PROFILE, M-METRICS, M-USER-STORE</depends>
      <target>
        <source>src/mtproto-server.js</source>
        <tests>tests/mtproto.e2e.test.js</tests>
      </target>
      <observability>
        <log-prefix>[mtproto]</log-prefix>
        <critical-block>BLOCK_MT_RELAY</critical-block>
      </observability>
      <verification-ref>V-M-MTPROTO</verification-ref>
      <notes>
        <note-1>FAST_MODE: клиент→DC перешифровка (decrypt клиента → encrypt upstream); DC→клиент байт-в-байт. resolveDc может вернуть массив кандидатов — TCP connect-failure → следующий кандидат (лог mtproto_dc_fallback); одиночный {host,port} нормализуется (обр. совместимость).</note-1>
      </notes>
    </M-MTPROTO-SERVER>

    <M-FAKETLS NAME="FakeTLS" TYPE="CORE_LOGIC" LAYER="1" ORDER="5" STATUS="implemented">
      <contract>
        <purpose>Fake-TLS (ee-secret) handshake: HMAC-валидация ClientHello, ServerHello с ALPN, TLS-record framing, SNI-парсинг, alert</purpose>
        <inputs>
          <param name="handshake" type="Buffer" />
          <param name="secrets" type="Buffer[]" />
          <param name="secret, clientDigest, sessionId, alpn?" type="buildServerHello args" />
          <param name="description" type="number" />
        </inputs>
        <outputs>
          <param name="{ secret, sessionId, digest } | null" type="validateClientHello" />
          <param name="Buffer" type="buildServerHello / wrapTlsRecord / buildTlsAlert" />
          <param name="string | null" type="extractSni" />
        </outputs>
        <errors><error code="none" /></errors>
      </contract>
      <interface>
        <export-validateClientHello PURPOSE="Валидировать ClientHello по HMAC" />
        <export-buildServerHello PURPOSE="Построить ServerHello (+ALPN) + CCS + app-data" />
        <export-createTlsRecordReader PURPOSE="Stateful парсер TLS-записей" />
        <export-wrapTlsRecord PURPOSE="Обернуть данные в TLS 1.3 app-data" />
        <export-extractSni PURPOSE="Распарсить SNI (null если нет)" />
        <export-buildTlsAlert PURPOSE="Fatal TLS alert (reject_handshake)" />
        <export-buildAlpnExtension PURPOSE="ALPN-расширение для ServerHello" />
      </interface>
      <depends>node:crypto</depends>
      <target>
        <source>src/faketls.js</source>
        <tests>tests/faketls.test.js</tests>
      </target>
      <observability>
        <log-prefix>[faketls]</log-prefix>
        <critical-block>BLOCK_BUILD</critical-block>
      </observability>
      <verification-ref>V-M-FAKETLS</verification-ref>
      <notes>
        <note-1>Синтетический ServerHello; ALPN добавляется при наличии cfg.mtprotoTlsAlpn. extractSni lenient: null при отсутствии SNI.</note-1>
      </notes>
    </M-FAKETLS>

    <M-MASK NAME="Mask" TYPE="CORE_LOGIC" LAYER="2" ORDER="4" STATUS="implemented">
